# Credit Count environment variables.
#
# Only names are documented here. Never commit real values, and never introduce a
# service-role key or database credential: the application runtime is designed to
# work with the publishable key alone, because Row Level Security — not the client
# — is the authorization boundary.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Automated tests only (tests/api and tests/e2e). Not used by the application
# runtime and not required to build or deploy. The browser suite deletes this
# enthusiast's rides before every test, so these accounts are not demo-safe.
TEST_ENTHUSIAST_EMAIL=
TEST_ENTHUSIAST_PASSWORD=
TEST_OTHER_EMAIL=
TEST_OTHER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Demo accounts handed to a reviewer, seeded with ride history and opted into
# the leaderboard. Deliberately separate from the TEST_* accounts above so a
# test run cannot empty them. Created by scripts/create-reviewer-accounts.mjs.
REVIEWER_ENTHUSIAST_EMAIL=
REVIEWER_ENTHUSIAST_PASSWORD=
REVIEWER_ADMIN_EMAIL=
REVIEWER_ADMIN_PASSWORD=
