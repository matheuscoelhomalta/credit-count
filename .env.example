# Credit Count environment variables.
#
# Only names are documented here. Never commit real values, and never introduce a
# service-role key or database credential: the application runtime is designed to
# work with the publishable key alone, because Row Level Security — not the client
# — is the authorization boundary.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Direct Data API security tests only (tests/api). Not used by the application
# runtime and not required to build or deploy.
TEST_ENTHUSIAST_EMAIL=
TEST_ENTHUSIAST_PASSWORD=
TEST_OTHER_EMAIL=
TEST_OTHER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
